# Required Discord bot credential
BARK_BOT_TOKEN=replace-with-discord-bot-token

# Bot behavior
BARK_COMMAND_PREFIX=!
BARK_SYNC_COMMANDS=true

# Dashboard
BARK_DASHBOARD_HOST=127.0.0.1
BARK_DASHBOARD_PORT=8090
BARK_PUBLIC_URL=https://bark.example.com
BARK_FORCE_HTTPS=true
# Generate a persistent value, for example: python3 -c "import secrets; print(secrets.token_hex(32))"
BARK_SECRET_KEY=replace-with-random-session-signing-key
BARK_INVITE_URL=https://discord.com/oauth2/authorize?client_id=replace-with-client-id

# Discord OAuth2 dashboard login (set all three together)
BARK_OAUTH2_CLIENT_ID=replace-with-client-id
BARK_OAUTH2_CLIENT_SECRET=replace-with-client-secret
BARK_OAUTH2_REDIRECT_URI=https://bark.example.com/auth/callback
# Required with OAuth: only these Discord user IDs can administer hosted-instance access links.
BARK_OWNER_DISCORD_IDS=replace-with-owner-discord-id

# Persistence and diagnostics
BARK_DATA_DIR=data
BARK_DATABASE_URL=sqlite+aiosqlite:///bark.db
BARK_DATABASE_ECHO=false
BARK_LOG_LEVEL=INFO
